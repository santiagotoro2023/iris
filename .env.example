POSTGRES_USER=iris
POSTGRES_PASSWORD=changeme
POSTGRES_DB=iris

IRIS_MODEL=qwen3:8b
# Reads uploaded images. Changeable in Settings; this is only the first-run default.
IRIS_VISION_MODEL=qwen2.5vl:3b
# Embeds memories for semantic search. Multilingual, which matters for German.
IRIS_EMBED_MODEL=bge-m3
IRIS_TZ=Europe/Zurich
# true = always reason before answering (slow), false = never (default),
# anything else = omit the flag, which non-thinking models such as qwen2.5 require.
IRIS_THINK=
# Set to 1 only behind a real TLS terminator. Tailscale serves plain HTTP over its
# own encrypted tunnel, where a Secure cookie would prevent logging in at all.
IRIS_COOKIE_SECURE=0

# Voice services. Model/device/speaker are also editable in the UI; these are the
# seed defaults used before anything is stored.
STT_MODEL=large-v3
STT_DEVICE=cuda
STT_COMPUTE=int8_float16
TTS_ENGINE=piper
TTS_SPEAKER=en_GB-cori-high
TTS_DEVICE=cuda
